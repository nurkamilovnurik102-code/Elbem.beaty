# Copy to .env.local in the same directory as package.json, NEVER commit .env.local.
# These Firebase Web SDK settings are public identifiers, not Admin SDK credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional for Spark-only, the application does not use Firebase Storage
VITE_FIREBASE_STORAGE_BUCKET=
# Salon number in international format without spaces or +, set by the owner
VITE_SALON_WHATSAPP=
# Optional: prefill owner email in the sign-in form; this does NOT grant admin access
VITE_ADMIN_LOGIN_EMAIL=
# Optional: enable ONLY after configuring reCAPTCHA and Firebase App Check
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Existing admin Firebase Auth email, holding admin:true. Public identifier, not a password.
# Required for the two-step admin gate with just one admin-password field.
# VITE_ADMIN_LOGIN_EMAIL=admin@example.com (set the existing administrator account email above)
# Optional Cloudinary UNSIGNED preset for device file uploads visible to everyone.
# Preset is public: configure strict allowed formats, transformations and abuse monitoring.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
